{
    "model": {
        "name": "polaris_uox_pin_quick",
        "description": "A 2D Polaris PWR UOX pin cell.",
        "sources":
        {
            "1":"Characteristics of Spent Fuel, High-Level Waste, and other Radioactive Wastes which May Require Long-Term Isolation, Appendix 2A. Physical Descriptions of LWR Assemblies, DOE/RW-0184, Volume 3 of 6, U.S. DOE Office of Civilian Radioactive Waste Management, 1987.",
            "2": "SCALE sample problem polaris_dv1a.inp.",
            "3": "SCALE sample problem polaris.6.2.bench_taka3_sf97-4_pin.inp."
        },
        "revision":
        [
            "2026 - Added as a Polaris PWR UOX single-pin quick validation case."
        ],
        "notes":
        [
            "The model is a quick product validation case with a single fuel material.",
            "The single fuel material is intended to isolate high-order to ORIGAMI inventory consistency from assembly homogenization effects."
        ]
    },
    "generate": {
        "_type": "scale.olm.generate.root:jt_expander",
        "template": "model.jt.inp",
        "artifact_contract": "Polaris",
        "comp": {
            "fuel":{
                "_type": "scale.olm.generate.comp:uo2_nuregcr5625",
                "density": 10.4
            }
        },
        "static": {
            "_type": "scale.olm.generate.static:pass_through",
            "xslib": "broad_lwr",
            "pitch": 1.26,
            "fuelr": 0.4096,
            "gapr": 0.4180,
            "cladr": 0.4750
        },
        "states": {
            "_type": "scale.olm.generate.states:full_hypercube",
            "coolant_density": [
                0.72
            ],
            "enrichment": [
                3.0
            ],
            "specific_power": [
                40.0
            ],
            "boron_ppm": [
                600.0
            ]
        },
        "time": {
            "_type": "scale.olm.generate.static:pass_through",
            "gwd_burnups": [
                0.5,
                1.0,
                5.0,
                10.0,
                25.0,
                50.0,
                70.0
            ]
        }
    },
    "run": {
        "_type": "scale.olm.run:makefile",
        "dry_run": false
    },
    "assemble": {
        "_type": "scale.olm.assemble:arpdata_txt",
        "fuel_type": "UOX",
        "dim_map":
        {
            "enrichment": "enrichment",
            "mod_dens": "coolant_density"
        },
        "keep_every": 1
    },
    "check": {
        "_type": "scale.olm.check:sequencer",
        "sequence":
        [{
            "_type": "scale.olm.check:LowOrderConsistency",
            "name": "loc",
            "template": "model/origami/system-uox.jt.inp",
            "metric": "grams_per_initial_hm",
            "nlib_start": 1,
            "nlib_max": 4,
            "nburn_start": 1,
            "nburn_max": 4,
            "q1_stop_criteria": 0.005,
            "q2_stop_criteria": 0.005,
            "target_q1": 0.70,
            "target_q2": 0.95,
            "eps0": 1e-12,
            "epsa": 1e-6,
            "epsr": 1e-3,
            "nuclide_compare": ["u235","pu239","pu240","pu241","pu242","am241",
                "pu239", "u234", "u238", "cs134", "cs137","nd148","eu154",
                "am242m","am243", "cm242", "cm244"]
        }]
    },
    "report": {
        "_type": "scale.olm.report:rst2pdf",
        "template": "report.jt.rst"
    }
}
