{
    "model": {
        "name": "polaris_mox_pin_quick",
        "description": "A 2D Polaris PWR MOX pin cell.",
        "sources": {
            "1": "SCALE Polaris pin-cell and OLM MOX quick validation examples."
        },
        "revision": [
            "2026 - Added as a Polaris PWR MOX quick validation case."
        ],
        "notes": [
            "The model is a quick product validation case with one fuel material.",
            "MOX support in SCALE 6.3 validation is limited; this example is intended for SCALE 7 validation."
        ]
    },
    "generate": {
        "_type": "scale.olm.generate.root:jt_expander",
        "template": "model.jt.inp",
        "artifact_contract": "Polaris",
        "comp": {
            "inner": {
                "_type": "scale.olm.generate.comp:mox_ornltm2003_2",
                "density": 10.4,
                "uo2": {
                    "iso": {
                        "u234": 0.001,
                        "u235": 0.24,
                        "u236": 0.001,
                        "u238": 99.75
                    }
                },
                "am241": 1.6
            }
        },
        "static": {
            "_type": "scale.olm.generate.static:pass_through",
            "xslib": "broad_lwr",
            "pitch": 1.26,
            "fuelr": 0.4096,
            "gapr": 0.4180,
            "cladr": 0.4750
        },
        "states": {
            "_type": "scale.olm.generate.states:full_hypercube",
            "coolant_density": [0.72],
            "pu_frac": [4.0],
            "pu239_frac": [60.0],
            "specific_power": [40.0],
            "boron_ppm": [600.0]
        },
        "time": {
            "_type": "scale.olm.generate.static:pass_through",
            "gwd_burnups": [0.5, 1.0, 5.0, 10.0, 25.0, 50.0]
        }
    },
    "run": {
        "_type": "scale.olm.run:makefile",
        "dry_run": false
    },
    "assemble": {
        "_type": "scale.olm.assemble:arpdata_txt",
        "fuel_type": "MOX",
        "dim_map": {
            "pu_frac": "pu_frac",
            "pu239_frac": "pu239_frac",
            "mod_dens": "coolant_density"
        },
        "keep_every": 1
    },
    "check": {
        "_type": "scale.olm.check:sequencer",
        "sequence": [{
            "_type": "scale.olm.check:LowOrderConsistency",
            "name": "loc",
            "template": "model/origami/system-mox.jt.inp",
            "metric": "grams_per_initial_hm",
            "nlib_start": 1,
            "nlib_max": 4,
            "nburn_start": 1,
            "nburn_max": 4,
            "q1_stop_criteria": 0.005,
            "q2_stop_criteria": 0.005,
            "target_q1": 0.70,
            "target_q2": 0.95,
            "eps0": 1e-12,
            "epsa": 1e-6,
            "epsr": 1e-3,
            "nuclide_compare": ["u235", "pu239", "pu240", "pu241", "pu242", "am241"]
        }]
    },
    "report": {
        "_type": "scale.olm.report:rst2pdf",
        "template": "report.jt.rst"
    }
}
