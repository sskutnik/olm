=shell
olm link -p {{_.env.work_dir}} {{_.model.name}}
end

=origami

libs=[ {{_.model.name}} ]

options{ ft71=all mtu={{history.initialhm}} nburn={{convergence_control.nburn}} }

{%- set target_pu239 = _arpinfo.interpvars.pu239_frac -%}
{%- set pu_vector_scale = (100.0 - target_pu239) / (100.0 - comp.system.puo2.iso.pu239) -%}
{%- set pu_component = _arpinfo.interpvars.pu_frac / comp.system.info.puo2_hm_frac -%}
{%- set am_component = 100.0 * comp.system.amo2.dens_frac * comp.system.info.amo2_hm_frac -%}
{%- set am_oxygen_component = 100.0 * comp.system.amo2.dens_frac * (1.0 - comp.system.info.amo2_hm_frac) -%}
{%- set uo2_component = 100.0 - pu_component - am_component - am_oxygen_component -%}

fuelcomp{
    stdcomp(c_uo2){ base=uo2 dens={{comp.system.density}}
        iso[
            92234={{comp.system.uo2.iso.u234}}
            92235={{comp.system.uo2.iso.u235}}
            92236={{comp.system.uo2.iso.u236}}
            92238={{comp.system.uo2.iso.u238}}
        ]
    }
    stdcomp(c_puo2){ base=puo2 dens={{comp.system.density}}
        iso[
            94238={{comp.system.puo2.iso.pu238 * pu_vector_scale}}
            94239={{target_pu239}}
            94240={{comp.system.puo2.iso.pu240 * pu_vector_scale}}
            94241={{comp.system.puo2.iso.pu241 * pu_vector_scale}}
            94242={{comp.system.puo2.iso.pu242 * pu_vector_scale}}
        ]
    }
    stdcomp(c_am){ base=am  dens={{comp.system.density}}
        iso[
            95241={{comp.system.amo2.iso.am241}}
        ]
    }
    stdcomp(c_o2){ base=o  dens={{comp.system.density}}
    }
    mix(1){ comps[
        c_uo2 = {{uo2_component}}
        c_puo2 = {{pu_component}}
        c_am = {{am_component}}
        c_o2 = {{am_oxygen_component}}
    ] }
}

modz = [ {{_arpinfo.interpvars.mod_dens}} ]
pz = [ 1.0 ]

hist[
  {%- for pb in history.burndata %}
  cycle{ power={{pb.power}} burn={{pb.burn}} nlib={{convergence_control.nlib}} }
  {%- endfor %}
]

end
